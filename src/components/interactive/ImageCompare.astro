---
// 같은 크기의 두 결과 이미지를 겹쳐 놓고 슬라이더로 경계를 옮겨 비교한다.
// 여러 사례(case)와 비교 쌍(pair)을 버튼으로 바꿀 수 있다. JS 없이도 50% 분할 상태로 보인다.
import { Image } from "astro:assets";
import Badge from "../Badge.astro";
import { loadFigure } from "../../lib/figures";

type Case = { figure: string; label: string; /** 논리 키 → 패널 키 */ map?: Record<string, string> };
type Pair = { left: string; right: string; label: string };
interface Props {
  title: string;
  cases: Case[];
  pairs: Pair[];
  labels: Record<string, string>;
  caption?: string;
  /** 인쇄본에 실을 사례 수 (생략하면 전부) */
  printLimit?: number;
}

const { title, cases, pairs, labels, caption, printLimit } = Astro.props;
const keys = [...new Set(pairs.flatMap((p) => [p.left, p.right]))];

const loaded = await Promise.all(
  cases.map(async (c) => {
    const fig = await loadFigure(c.figure);
    const panels = keys.map((k) => {
      const panelKey = c.map?.[k] ?? k;
      const p = fig.panels[panelKey];
      if (!p) throw new Error(`패널 없음: ${c.figure}.${panelKey}`);
      return { ...p, key: k };
    });
    return { ...c, fig, panels };
  }),
);
const visible = loaded.every((c) => c.fig.visible);
const anyReview = loaded.some((c) => c.fig.isReview);
const uid = `cmp-${Math.random().toString(36).slice(2, 8)}`;
const first = pairs[0]!;
// 인쇄본: 슬라이더 대신 첫 번째 비교 쌍을 사례마다 나란히 놓는다.
const print = Astro.locals.print === true;
---

<figure class:list={["cmp", { print }]} data-cmp data-left={first.left} data-right={first.right}>
  <figcaption class="top">
    <span class="title">{title}</span>
    <span class="badges"><Badge kind="rendered" />{anyReview && visible && <Badge kind="review" />}</span>
  </figcaption>
  {
    print && visible ? (
      <div class="print-grid">
        {loaded.slice(0, printLimit ?? loaded.length).map((c) => (
          <div class="print-row">
            {cases.length > 1 && <p class="print-case">{c.label}</p>}
            <div class="print-pair">
              {[first.left, first.right].map((k) => {
                const p = c.panels.find((x) => x.key === k)!;
                return (
                  <div class="print-cell">
                    <span class:list={["lab", k === first.right ? "right" : "left"]}>{labels[k]}</span>
                    <Image src={p.image!} alt={p.alt} widths={[Math.min(p.image!.width, 600)]} format="webp" quality={92} />
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    ) : visible ? (
      <>
        <div class="controls">
          {cases.length > 1 && (
            <div class="seg" role="group" aria-label="사례 선택">
              {loaded.map((c, i) => (
                <button type="button" data-case-btn={i} aria-pressed={i === 0 ? "true" : "false"}>
                  {c.label}
                </button>
              ))}
            </div>
          )}
          {pairs.length > 1 && (
            <div class="seg" role="group" aria-label="비교 대상 선택">
              {pairs.map((p, i) => (
                <button type="button" data-pair-btn data-left={p.left} data-right={p.right} aria-pressed={i === 0 ? "true" : "false"}>
                  {p.label}
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="stage" style="--pos: 50%">
          {loaded.map((c, i) => (
            <div class="case" data-case={i} hidden={i !== 0}>
              {c.panels.map((p) => (
                <Image
                  src={p.image!}
                  alt={p.alt}
                  data-key={p.key}
                  widths={[...new Set([360, 600, 900].filter((w) => w < p.image!.width).concat([Math.min(p.image!.width, 900)]))]}
                  sizes="(max-width: 760px) 100vw, 720px"
                  format="webp"
                  quality={92}
                  loading={i === 0 ? "eager" : "lazy"}
                />
              ))}
            </div>
          ))}
          <span class="divider" aria-hidden="true" />
          <span class="lab left" data-lab-left>{labels[first.left]}</span>
          <span class="lab right" data-lab-right>{labels[first.right]}</span>
        </div>
        <label class="range" for={uid}>
          <span class="visually-hidden">비교 경계 위치</span>
          <input id={uid} type="range" min="0" max="100" value="50" step="1" data-range aria-valuetext="왼쪽 50%, 오른쪽 50%" />
        </label>
        <p class="hint">슬라이더나 이미지를 드래그하면 경계가 움직입니다. 키보드에서는 방향키를 쓰세요.</p>
      </>
    ) : (
      <div class="placeholder" role="img" aria-label={`공개 확인 전이라 숨긴 비교 이미지: ${title}`}>
        <p><strong>공개 확인 전인 그림</strong><br />데이터셋·논문 그림의 공개 조건을 확인한 뒤 표시합니다.</p>
      </div>
    )
  }
  <figcaption class="bottom">
    {caption}
    {print && printLimit && printLimit < cases.length && ` 인쇄본에는 ${cases.length}개 중 ${printLimit}개를 실었습니다(웹에서 전부 비교 가능).`}
  </figcaption>
  <script type="application/json" data-labels set:html={JSON.stringify(labels)} />
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-cmp]")) {
    const stage = root.querySelector<HTMLElement>(".stage");
    const range = root.querySelector<HTMLInputElement>("[data-range]");
    if (!stage || !range) continue;
    const labels = JSON.parse(root.querySelector("[data-labels]")?.textContent ?? "{}") as Record<string, string>;
    const labL = root.querySelector<HTMLElement>("[data-lab-left]")!;
    const labR = root.querySelector<HTMLElement>("[data-lab-right]")!;

    const setPos = (v: number) => {
      const pos = Math.min(100, Math.max(0, v));
      stage.style.setProperty("--pos", `${pos}%`);
      range.value = String(Math.round(pos));
      range.setAttribute("aria-valuetext", `${labL.textContent} ${Math.round(pos)}%, ${labR.textContent} ${100 - Math.round(pos)}%`);
    };
    const applyPair = () => {
      const { left, right } = root.dataset;
      for (const img of stage.querySelectorAll<HTMLElement>("img[data-key]")) {
        const k = img.dataset.key;
        img.classList.toggle("is-left", k === left);
        img.classList.toggle("is-right", k === right);
      }
      labL.textContent = labels[left!] ?? "";
      labR.textContent = labels[right!] ?? "";
      setPos(Number(range.value));
    };

    range.addEventListener("input", () => setPos(Number(range.value)));

    let dragging = false;
    const fromPointer = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      setPos(((e.clientX - r.left) / r.width) * 100);
    };
    stage.addEventListener("pointerdown", (e) => {
      dragging = true;
      stage.setPointerCapture(e.pointerId);
      fromPointer(e);
    });
    stage.addEventListener("pointermove", (e) => dragging && fromPointer(e));
    stage.addEventListener("pointerup", () => (dragging = false));
    stage.addEventListener("pointercancel", () => (dragging = false));

    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-case-btn]")) {
      btn.addEventListener("click", () => {
        const i = btn.dataset.caseBtn;
        for (const c of stage.querySelectorAll<HTMLElement>("[data-case]")) c.hidden = c.dataset.case !== i;
        for (const b of root.querySelectorAll("[data-case-btn]")) b.setAttribute("aria-pressed", String(b === btn));
      });
    }
    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-pair-btn]")) {
      btn.addEventListener("click", () => {
        root.dataset.left = btn.dataset.left;
        root.dataset.right = btn.dataset.right;
        for (const b of root.querySelectorAll("[data-pair-btn]")) b.setAttribute("aria-pressed", String(b === btn));
        applyPair();
      });
    }
    applyPair();
  }
</script>

<style>
  .cmp {
    margin: var(--sp-5) 0;
    background: var(--c-surface);
    color: var(--c-text);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--sp-3);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }
  /* 인쇄본 */
  .cmp.print {
    background: none;
    border: 0;
    color: var(--c-text);
    padding: 0;
    break-inside: avoid;
  }
  .cmp.print .bottom {
    color: var(--c-text-3);
  }
  /* 사례 두 개를 한 줄에, 각 사례는 비교 쌍 두 장 */
  .print-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 10px;
  }
  .print-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3px;
  }
  .print-case {
    font-size: var(--fs-xs);
    font-weight: 600;
    margin: 0 0 2px;
  }
  .print-cell .lab {
    top: 4px;
    font-size: 6.5pt;
  }
  .print-cell .lab.left {
    left: 4px;
    color: #fff;
  }
  .print-cell .lab.right {
    right: 4px;
  }
  .print-cell {
    position: relative;
  }
  .print-cell :global(img) {
    width: 100%;
    border-radius: 3px;
  }
  .title {
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .badges {
    display: inline-flex;
    gap: var(--sp-1);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-bottom: var(--sp-3);
  }
  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    padding: 2px;
    border-radius: var(--radius-sm);
  }
  .seg button {
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--c-text-2);
    background: transparent;
    border: 0;
    border-radius: 4px;
    padding: 0.35em 0.75em;
    cursor: pointer;
  }
  .seg button[aria-pressed="true"] {
    background: var(--c-surface);
    color: var(--c-text);
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--c-border-strong);
  }
  .seg button:focus-visible {
    outline: 2px solid var(--c-accent);
  }
  .stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: 4px;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
  }
  .case {
    display: grid;
  }
  .case[hidden] {
    display: none;
  }
  .stage :global(img) {
    grid-area: 1 / 1;
    width: 100%;
    display: none;
    pointer-events: none;
  }
  .stage :global(img.is-left),
  .stage :global(img.is-right) {
    display: block;
  }
  .stage :global(img.is-right) {
    clip-path: inset(0 0 0 var(--pos));
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .lab {
    position: absolute;
    top: 8px;
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 0.05em 0.5em;
    border-radius: 4px;
    pointer-events: none;
  }
  .lab.left {
    left: 8px;
    background: rgb(17 18 20 / 0.78);
    color: var(--c-viewer-text);
  }
  .lab.right {
    right: 8px;
    background: var(--c-accent);
    color: #fff;
  }
  .range {
    display: block;
    margin-top: var(--sp-2);
  }
  .range input {
    width: 100%;
    accent-color: var(--c-accent);
  }
  .hint {
    font-size: var(--fs-xs);
    color: var(--c-text-3);
  }
  .placeholder {
    display: grid;
    place-items: center;
    min-height: 180px;
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-sm);
    color: var(--c-text-3);
    text-align: center;
    padding: var(--sp-5);
    font-size: var(--fs-sm);
  }
  .bottom {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }
</style>
