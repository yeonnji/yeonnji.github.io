---
// figures.yaml의 그림을 보여준다. 출처·라이선스는 figures.yaml과 docs/licenses.md에 기록하고 화면에는 캡션만 싣는다. 공개 확인 전(review) 그림은 배포 빌드에서 아무것도 그리지 않는다.
import { Image } from "astro:assets";
import Badge from "./Badge.astro";
import { loadFigure } from "../lib/figures";

interface Props {
  id: string;
  /** 보여줄 패널과 순서. 생략하면 전부 */
  panels?: string[];
  /** 패널 위 라벨 */
  labels?: Record<string, string>;
  /** 한 줄에 놓을 패널 수 (좁은 화면에서는 자동으로 줄어듦) */
  columns?: number;
  /** 캡션을 덮어쓸 때 */
  caption?: string;
  wide?: boolean;
  /** 세로로 긴 화면 캡처 등을 줄여 보일 최대 폭 (예: "420px") */
  maxWidth?: string;
}

const { id, panels, labels = {}, columns, caption, wide = false, maxWidth } = Astro.props;
const fig = await loadFigure(id);
const keys = panels ?? Object.keys(fig.panels);
const cols = columns ?? keys.length;
const defaultLabels: Record<string, string> = {
  gt: "정답 (GT)",
  input: "입력",
  "3dgs": "표준 3DGS",
  ours: "제안 방법",
  mask: "소프트 마스크",
};
const sizes = `(max-width: 720px) ${cols > 1 ? "50vw" : "100vw"}, ${Math.round(1120 / cols)}px`;
---

{fig.visible && (
<figure class:list={["fig", { wide, screenshot: fig.kind === "screenshot" }]} data-figure={id} style={maxWidth ? `--fig-max:${maxWidth}` : undefined}>
  <div class="panels" style={`--cols:${cols}`}>
    {keys.map((k) => {
      const p = fig.panels[k];
      if (!p) throw new Error(`패널 없음: ${id}.${k}`);
      const label = labels[k] ?? defaultLabels[k];
      return (
        <div class:list={["panel", { ours: k === "ours", base: k === "3dgs" }]}>
          {label && cols > 1 && <span class="plabel">{label}</span>}
          <Image
            src={p.image!}
            alt={p.alt}
            widths={[360, 600, 900, Math.min(p.image!.width, 1600)].filter((w, i, a) => w <= p.image!.width && a.indexOf(w) === i)}
            sizes={sizes}
            format="webp"
            quality={92}
          />
        </div>
      );
    })}
  </div>
  <figcaption>
    <span class="badges">
      <Badge kind={fig.kind === "diagram" ? "diagram" : fig.kind === "document" ? "document" : fig.kind === "screenshot" ? "screen" : "rendered"} />
      {fig.isReview && <Badge kind="review" />}
    </span>
    {caption ?? fig.caption}
  </figcaption>
</figure>
)}

<style>
  .fig {
    margin: var(--sp-5) 0;
  }
  .fig .panels {
    max-width: var(--fig-max, none);
  }
  /* 틀 없이 패널마다 얇은 회색 테두리 */
  .panels {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--sp-2);
  }
  .panel {
    position: relative;
    margin: 0;
  }
  @media print {
    .fig {
      break-inside: avoid;
    }
  }
  .panel :global(img) {
    display: block;
    width: 100%;
    border: 1px solid var(--c-border);
    border-radius: 4px;
  }
  .plabel {
    position: absolute;
    left: 6px;
    top: 6px;
    z-index: 1;
    font-size: var(--fs-2xs);
    font-weight: 600;
    padding: 0.05em 0.5em;
    border-radius: 4px;
    background: rgb(17 18 20 / 0.78);
    color: var(--c-viewer-text);
  }
  .ours .plabel {
    background: var(--c-accent);
    color: #fff;
  }
  figcaption {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    line-height: var(--lh-snug);
    color: var(--c-text-2);
  }
  .badges {
    display: inline-flex;
    gap: var(--sp-1);
    margin-right: var(--sp-2);
  }
  @media (max-width: 720px) {
    .panels {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }
</style>
