---
// figures.yaml의 그림을 보여준다. 공개 확인 전(review) 그림은 배포 빌드에서 자리표시로 바뀐다.
import { Image } from "astro:assets";
import Badge from "./Badge.astro";
import { loadFigure } from "../lib/figures";

interface Props {
  id: string;
  /** 보여줄 패널과 순서. 생략하면 전부 */
  panels?: string[];
  /** 패널 위 라벨 */
  labels?: Record<string, string>;
  /** 한 줄에 놓을 패널 수 (좁은 화면에서는 자동으로 줄어듦) */
  columns?: number;
  /** 캡션을 덮어쓸 때 */
  caption?: string;
  wide?: boolean;
  /** 세로로 긴 화면 캡처 등을 줄여 보일 최대 폭 (예: "420px") */
  maxWidth?: string;
}

const { id, panels, labels = {}, columns, caption, wide = false, maxWidth } = Astro.props;
const fig = await loadFigure(id);
const keys = panels ?? Object.keys(fig.panels);
const cols = columns ?? keys.length;
const defaultLabels: Record<string, string> = {
  gt: "정답 (GT)",
  input: "입력",
  "3dgs": "표준 3DGS",
  ours: "제안 방법",
  mask: "소프트 마스크",
};
const sizes = `(max-width: 720px) ${cols > 1 ? "50vw" : "100vw"}, ${Math.round(1120 / cols)}px`;
---

<figure class:list={["fig", { wide, screenshot: fig.kind === "screenshot" }]} data-figure={id} style={maxWidth ? `--fig-max:${maxWidth}` : undefined}>
  {
    fig.visible ? (
      <div class="panels" style={`--cols:${cols}`}>
        {keys.map((k) => {
          const p = fig.panels[k];
          if (!p) throw new Error(`패널 없음: ${id}.${k}`);
          const label = labels[k] ?? defaultLabels[k];
          return (
            <div class:list={["panel", { ours: k === "ours", base: k === "3dgs" }]}>
              {label && cols > 1 && <span class="plabel">{label}</span>}
              <Image
                src={p.image!}
                alt={p.alt}
                widths={[360, 600, 900, Math.min(p.image!.width, 1600)].filter((w, i, a) => w <= p.image!.width && a.indexOf(w) === i)}
                sizes={sizes}
                format="webp"
                quality={92}
              />
            </div>
          );
        })}
      </div>
    ) : (
      <div class="placeholder" role="img" aria-label={`공개 확인 전이라 숨긴 그림: ${fig.caption}`}>
        <p>
          <strong>공개 확인 전인 그림</strong>
          <br />
          데이터셋·논문 그림의 공개 조건을 확인한 뒤 표시합니다.
        </p>
      </div>
    )
  }
  <figcaption>
    <span class="badges">
      <Badge kind={fig.kind === "diagram" ? "diagram" : fig.kind === "screenshot" ? "screen" : "rendered"} />
      {fig.isReview && fig.visible && <Badge kind="review" />}
    </span>
    {caption ?? fig.caption}
    <span class="src">출처: {fig.source.doc} {fig.source.location} · 데이터: {fig.dataset} · {fig.license}</span>
  </figcaption>
</figure>

<style>
  .fig {
    margin: var(--sp-5) 0;
  }
  .fig .panels {
    max-width: var(--fig-max, none);
  }
  /* 실제 화면 캡처는 어두운 틀 대신 얇은 테두리 */
  .fig.screenshot .panels {
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
  }
  .panels {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 6px;
    background: var(--c-viewer-bg);
    padding: 6px;
    border-radius: var(--radius);
  }
  .panel {
    position: relative;
    margin: 0;
  }
  @media print {
    .fig {
      break-inside: avoid;
    }
    .panels {
      background: none;
      padding: 0;
    }
  }
  .panel :global(img) {
    width: 100%;
    border-radius: 4px;
  }
  .plabel {
    position: absolute;
    left: 6px;
    top: 6px;
    z-index: 1;
    font-size: var(--fs-2xs);
    font-weight: 600;
    padding: 0.05em 0.5em;
    border-radius: 4px;
    background: rgb(17 18 20 / 0.78);
    color: var(--c-viewer-text);
  }
  .ours .plabel {
    background: var(--c-accent);
    color: #fff;
  }
  .placeholder {
    display: grid;
    place-items: center;
    min-height: 180px;
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius);
    background: var(--c-surface-2);
    color: var(--c-text-3);
    text-align: center;
    padding: var(--sp-5);
    font-size: var(--fs-sm);
  }
  figcaption {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    line-height: var(--lh-snug);
    color: var(--c-text-2);
  }
  .badges {
    display: inline-flex;
    gap: var(--sp-1);
    margin-right: var(--sp-2);
  }
  .src {
    display: block;
    font-size: var(--fs-xs);
    color: var(--c-text-3);
  }
  @media (max-width: 720px) {
    .panels {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }
</style>
