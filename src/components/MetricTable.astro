---
// metrics.json의 표를 렌더링한다. 본문에 숫자를 직접 쓰지 않고 이 컴포넌트만 사용한다.
import { getEntry } from "astro:content";
import Badge from "./Badge.astro";
import { fmt } from "../lib/format";

interface Props {
  id: string;
  /** 조건 목록을 접힌 상태로 둘지 */
  compact?: boolean;
}
const { id, compact = false } = Astro.props;
const entry = await getEntry("metrics", id);
if (!entry) throw new Error(`metrics.json에 없는 표: ${id}`);
const m = entry.data;

// 같은 group 안에서 열마다 더 나은 값을 찾는다 (group이 없으면 표 전체).
const best = new Map<string, number>();
const groupKey = (g?: string) => g ?? "__all";
for (const col of m.columns) {
  for (const row of m.rows) {
    const k = `${groupKey(row.group)}|${col.key}`;
    const v = row.values[col.key];
    if (v === undefined) continue;
    const cur = best.get(k);
    if (cur === undefined || (col.better === "higher" ? v > cur : v < cur)) best.set(k, v);
  }
}
const groupCounts = new Map<string, number>();
for (const r of m.rows) if (r.group) groupCounts.set(r.group, (groupCounts.get(r.group) ?? 0) + 1);
const seen = new Set<string>();
const hasGroups = m.rows.some((r) => r.group);
const captionId = `metric-${id}`;
// 인쇄본에서는 접힌 내용이 출력되지 않으므로 평가 조건을 항상 펼친다.
const open = Astro.locals.print === true || !compact;
---

<figure class="metric">
  <div class="scroll" role="region" aria-labelledby={captionId} tabindex="0">
    <table>
      <caption id={captionId}>{m.title}</caption>
      <thead>
        <tr>
          {hasGroups && <th scope="col">구분</th>}
          <th scope="col">방법</th>
          {
            m.columns.map((c) => (
              <th scope="col" class="numcol">
                {c.label}
                {c.unit && <span class="unit"> ({c.unit})</span>}
                <span class="dir" aria-label={c.better === "higher" ? "높을수록 좋음" : "낮을수록 좋음"}>
                  {c.better === "higher" ? "↑" : "↓"}
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          m.rows.map((r) => {
            const first = r.group && !seen.has(r.group);
            if (r.group) seen.add(r.group);
            return (
              <tr class:list={{ ours: r.ours, summary: r.summary, groupStart: first }}>
                {hasGroups && first && (
                  <th scope="rowgroup" rowspan={groupCounts.get(r.group!)} class="group">
                    {r.group}
                  </th>
                )}
                <th scope="row" class="method">{r.method}</th>
                {m.columns.map((c) => {
                  const v = r.values[c.key];
                  const isBest = v !== undefined && best.get(`${groupKey(r.group)}|${c.key}`) === v;
                  return <td class:list={["num", "numcol", { best: isBest && m.highlightBest && m.rows.length > 1 }]}>{v === undefined ? "–" : fmt(v, c.digits)}</td>;
                })}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <figcaption>
    <details open={open}>
      <summary>평가 조건과 출처</summary>
      <dl class="conditions">
        {
          m.conditions.map((c) => (
            <div>
              <dt>{c.label}</dt>
              <dd>
                {c.value} {c.status === "pending" && <Badge kind="pending" />}
              </dd>
            </div>
          ))
        }
        <div>
          <dt>출처</dt>
          <dd>
            {m.source.doc} · {m.source.location}
            {m.alsoIn.map((s) => <><br />{s.doc} · {s.location}</>)}
          </dd>
        </div>
      </dl>
      {m.notes.length > 0 && <ul class="notes">{m.notes.map((n) => <li>{n}</li>)}</ul>}
    </details>
  </figcaption>
</figure>

<style>
  .metric {
    margin: var(--sp-5) 0;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  caption {
    text-align: left;
    font-weight: 700;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-border);
  }
  th,
  td {
    padding: var(--sp-2) var(--sp-4);
    text-align: left;
    border-bottom: 1px solid var(--c-border);
    white-space: nowrap;
  }
  thead th {
    font-size: var(--fs-xs);
    color: var(--c-text-3);
    font-weight: 600;
    background: var(--c-surface-2);
  }
  .numcol {
    text-align: right;
  }
  .unit {
    font-weight: 400;
  }
  .dir {
    margin-left: 2px;
  }
  .group {
    font-weight: 600;
    vertical-align: top;
    white-space: normal;
    min-width: 8.5em;
    border-right: 1px solid var(--c-border);
  }
  .method {
    font-weight: 400;
    color: var(--c-baseline);
  }
  tr.ours .method {
    color: var(--c-accent-strong);
    font-weight: 600;
  }
  tr.summary {
    background: var(--c-surface-2);
  }
  td.best {
    font-weight: 700;
    color: var(--c-accent-strong);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  figcaption {
    border-top: 1px solid var(--c-border);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--c-text-2);
    background: var(--c-surface);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--c-text-2);
  }
  .conditions {
    margin: var(--sp-2) 0 0;
    display: grid;
    gap: var(--sp-1);
  }
  .conditions div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: var(--sp-3);
  }
  dt {
    color: var(--c-text-3);
  }
  dd {
    margin: 0;
  }
  .notes {
    margin: var(--sp-2) 0 0;
    padding-left: 1.1em;
  }
  @media (max-width: 560px) {
    .conditions div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media print {
    .metric {
      break-inside: avoid;
      margin: 8px 0;
    }
    th,
    td {
      padding: 2px 10px;
    }
    caption {
      padding: 4px 10px;
    }
    figcaption {
      padding: 4px 10px;
    }
    summary {
      display: none;
    }
    .conditions {
      margin-top: 0;
      gap: 0;
    }
    .conditions div {
      grid-template-columns: 8em 1fr;
    }
  }
</style>
