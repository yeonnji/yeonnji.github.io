---
// "한 것 / 하지 않은 것"을 나란히 보여준다. 항목에 pending을 주면 '확인 중' 배지를 붙인다.
import Badge from "./Badge.astro";

type Item = string | { text: string; pending?: boolean };
interface Props {
  mine: Item[];
  others: Item[];
  othersTitle?: string;
}
const { mine, others, othersTitle = "공동연구자 · 기존 코드" } = Astro.props;
const norm = (i: Item) => (typeof i === "string" ? { text: i, pending: false } : { pending: false, ...i });
---

<div class="roles">
  <section aria-labelledby="role-mine">
    <h3 id="role-mine">직접 한 일</h3>
    <ul>
      {mine.map(norm).map((i) => <li>{i.text} {i.pending && <Badge kind="pending" />}</li>)}
    </ul>
  </section>
  <section aria-labelledby="role-others" class="others">
    <h3 id="role-others">{othersTitle}</h3>
    <ul>
      {others.map(norm).map((i) => <li>{i.text} {i.pending && <Badge kind="pending" />}</li>)}
    </ul>
  </section>
</div>

<style>
  .roles {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--sp-3);
    margin: var(--sp-5) 0;
  }
  section {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-accent);
    border-radius: var(--radius);
    padding: var(--sp-4);
  }
  .others {
    border-top-color: var(--c-baseline);
  }
  h3 {
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-2);
  }
  ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: var(--fs-base);
    line-height: var(--lh-snug);
    display: grid;
    gap: var(--sp-1);
  }
  @media (max-width: 720px) {
    .roles {
      grid-template-columns: 1fr;
    }
  }
</style>
