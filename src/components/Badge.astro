---
interface Props {
  kind: "review" | "pending" | "rendered" | "diagram" | "document" | "web" | "computed" | "concept" | "screen";
}
const labels = {
  computed: "브라우저에서 계산",
  concept: "개념도 · 직접 작성",
  screen: "실제 화면",
  review: "공개 확인 전",
  pending: "확인 중",
  rendered: "원본 렌더러 결과",
  diagram: "논문 구성도",
  document: "과제 문서 그림",
  web: "웹 렌더러 · 근사 표현",
} as const;
const { kind } = Astro.props;
---

<span class:list={["badge", kind]}>{labels[kind]}</span>

<style>
  .badge {
    display: inline-block;
    font-size: var(--fs-2xs);
    font-weight: 600;
    line-height: 1.5;
    padding: 0.05em 0.55em;
    border-radius: 4px;
    white-space: nowrap;
    vertical-align: middle;
  }
  .review {
    color: var(--c-review);
    background: var(--c-review-bg);
  }
  .pending {
    color: var(--c-pending);
    background: var(--c-pending-bg);
  }
  .rendered {
    color: #23593d;
    background: #e6f2ea;
  }
  .diagram,
  .document {
    color: var(--c-text-2);
    background: var(--c-surface-2);
  }
  .computed {
    color: #3d4a5c;
    background: #eceff3;
  }
  .concept {
    color: var(--c-text-2);
    background: var(--c-surface-2);
    border: 1px dashed var(--c-border-strong);
  }
  .screen {
    color: #3d4a5c;
    background: #eceff3;
  }
  .web {
    color: #6a3d9a;
    background: #f1eafa;
  }
</style>
