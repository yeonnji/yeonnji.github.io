---
// 홈 프로젝트 목록의 카드 한 장. 카드 전체가 상세 페이지 링크다(제목 링크를 카드 크기로 늘림).
// 썸네일은 공개된 결과 이미지가 있으면 그 이미지, 없으면 제목·역할 표지나 본인 담당을 표시한 간단한 구성도.
import { Image } from "astro:assets";
import type { Experience } from "../lib/experiences";
import { loadFigure, type ResolvedPanel } from "../lib/figures";
import { href } from "../lib/format";
import Badge from "./Badge.astro";

interface Props {
  exp: Experience;
}
const { exp } = Astro.props;
const d = exp.entry.data;
const c = d.card;
const url = href(exp.path);

let panels: (ResolvedPanel & { label?: string })[] = [];
let isReview = false;
if (c.thumb) {
  const fig = await loadFigure(c.thumb.figure);
  if (fig.visible) {
    panels = c.thumb.panels.map((k, i) => ({ ...fig.panels[k], label: c.thumb!.labels?.[i] }));
    isReview = fig.isReview;
  }
}
const hasImage = panels.length > 0 && panels.every((p) => p.image);
---

<li class="exp" id={`exp-${exp.id}`} data-cat={c.categories.join(" ")}>
  <div class="thumb" aria-hidden="true">
    {
      hasImage ? (
        <div class="panels" style={`--n:${panels.length}`}>
          {panels.map((p) => (
            <figure>
              <Image src={p.image!} alt="" widths={[200, 300, 420]} sizes="(max-width: 600px) 50vw, 200px" format="webp" quality={86} />
              {p.label && <figcaption>{p.label}</figcaption>}
            </figure>
          ))}
          {isReview && <span class="rb"><Badge kind="review" /></span>}
        </div>
      ) : c.diagram ? (
        <div class="cover diagram">
          <span class="ck">구성도 · 본인 담당 강조</span>
          <ol>
            {c.diagram.map((n) => (
              <li class:list={{ mine: n.mine }}>{n.label}</li>
            ))}
          </ol>
        </div>
      ) : (
        <div class="cover plain">
          <span class="ct">{d.title}</span>
          <span class="cr">{c.role}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="kinds">
      <span class="kind">{c.kind}</span>
      {c.badge && <span class="badge">{c.badge}</span>}
      {c.draft && <span class="draft">수정 예정</span>}
    </p>
    <h3><a href={url}>{d.title}</a></h3>
    <p class="blurb">{c.blurb}</p>
    <p class="who"><span class="role">{c.role}</span><span class="period num">{c.period}</span></p>
    <ul class="tag-list" aria-label="주요 기술">{c.tags.map((t) => <li class="tag">{t}</li>)}</ul>
  </div>
</li>

<style>
  .exp {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
    /* 상세 페이지에서 목록으로 돌아올 때 고정 머리글에 가리지 않게 */
    scroll-margin-top: 72px;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .exp:hover,
  .exp:focus-within {
    border-color: var(--c-border-strong);
    box-shadow: var(--shadow);
  }
  .exp:focus-within {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  .thumb {
    aspect-ratio: 16 / 10;
    background: var(--c-surface-2);
    border-bottom: 1px solid var(--c-border);
    overflow: hidden;
  }
  .panels {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 2px;
    height: 100%;
    background: var(--c-border);
  }
  .panels figure {
    position: relative;
    margin: 0;
    min-width: 0;
  }
  .panels :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .panels figcaption {
    position: absolute;
    left: 6px;
    bottom: 6px;
    font-size: var(--fs-2xs);
    font-weight: 600;
    color: #fff;
    background: rgb(0 0 0 / 0.62);
    padding: 1px 6px;
    border-radius: 4px;
  }
  .rb {
    position: absolute;
    right: 6px;
    top: 6px;
  }
  .cover {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-surface-2);
  }
  .ct {
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: var(--lh-tight);
    color: var(--c-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cr {
    font-size: var(--fs-xs);
    color: var(--c-text-2);
    font-weight: 600;
  }
  .ck {
    font-size: var(--fs-2xs);
    color: var(--c-text-3);
  }
  .diagram ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 4px;
  }
  .diagram li {
    position: relative;
    font-size: var(--fs-xs);
    line-height: 1.3;
    padding: 4px 8px;
    border: 1px solid var(--c-border-strong);
    border-radius: 6px;
    background: var(--c-surface);
    color: var(--c-text-2);
  }
  .diagram li.mine {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #fff;
    font-weight: 600;
  }
  .diagram li:not(:last-child) {
    margin-right: 14px;
  }
  .diagram li:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -14px;
    color: var(--c-text-3);
    font-weight: 400;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4);
    flex: 1;
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
  }
  .kind {
    font-size: var(--fs-2xs);
    font-weight: 600;
    line-height: 1.6;
    padding: 0 0.55em;
    border: 1px solid var(--c-border-strong);
    border-radius: 4px;
    color: var(--c-text-2);
    white-space: nowrap;
  }
  .draft {
    font-size: var(--fs-2xs);
    font-weight: 700;
    line-height: 1.6;
    padding: 0 0.55em;
    border: 1px dashed var(--c-pending);
    border-radius: 4px;
    color: var(--c-pending);
    background: var(--c-pending-bg);
    white-space: nowrap;
  }
  .badge {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-accent-strong);
  }
  h3 {
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
  }
  h3 a {
    color: var(--c-text);
    text-decoration: none;
  }
  /* 카드 전체를 링크 영역으로 */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .exp:hover h3 a {
    color: var(--c-accent-strong);
    text-decoration: underline;
  }
  .blurb {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    line-height: var(--lh-snug);
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--sp-3);
    font-size: var(--fs-xs);
    margin-top: auto;
    padding-top: var(--sp-2);
  }
  .role {
    font-weight: 600;
    color: var(--c-text);
  }
  .period {
    font-size: var(--fs-2xs);
    color: var(--c-text-3);
  }
  .tag-list {
    position: relative;
  }
</style>
